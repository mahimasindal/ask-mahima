# Copy this file to .env and fill in your real values. Never commit .env.

# Required — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Optional overrides (defaults shown)
LLM_MODEL=openai/gpt-4o-mini
# EMBEDDING_MODEL_NAME is currently unused — embeddings use ChromaDB's
# built-in ONNX model (see app/services/embeddings.py), not this setting.
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=mahima_knowledge_base
TOP_K=8
DATA_DIR=./data
