# Optional overrides (defaults shown)
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=mahima_knowledge_base
TOP_K=8
DATA_DIR=./data
